const obs = new IntersectionObserver(entries => {
  entries.forEach((e, i) => {
    if(e.isIntersecting){
      e.target.style.transitionDelay = (i * .05) + 's';
      e.target.classList.add('on');
      obs.unobserve(e.target);
    }
  });
}, {threshold:.08});
document.querySelectorAll('.rev').forEach(el => obs.observe(el));

